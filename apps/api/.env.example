# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_VERSION=v1

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/pharmasyn_dev"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRY=7d
COOKIE_SAME_SITE=lax

# ─── Cloudflare R2 ────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=pharmasyn-files

# ─── Resend ───────────────────────────────────────────────────────────────────
# Required for registration and password-reset email delivery.
# RESEND_FROM_EMAIL must belong to a domain verified in the same Resend account.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@pharmasyn.com
RESEND_FROM_NAME=PharmaSY

# Pharmacy-to-pharmacy exchange remains disabled until legal limits and
# moderation rules are approved for the deployment country.
EXCHANGE_MARKETPLACE_ENABLED=false

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Reports and private exports
REPORT_SYNC_ROW_LIMIT=5000
REPORT_SYNC_PDF_ROW_LIMIT=1000
REPORT_ASYNC_ROW_LIMIT=100000
REPORT_ASYNC_PDF_ROW_LIMIT=5000
REPORT_SIGNED_URL_TTL_SECONDS=900
REPORT_EXPORT_RETENTION_HOURS=24
